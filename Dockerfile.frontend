FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements_front.txt .
RUN pip install --no-cache-dir -r requirements_front.txt

COPY gan_busters/__init__.py ./gan_busters/__init__.py
COPY gan_busters/streamlit_app.py ./gan_busters/streamlit_app.py
COPY gan_busters/pages gan_busters/pages

EXPOSE 8080

CMD ["streamlit", "run", \
    "gan_busters/streamlit_app.py", \
    "--server.address=0.0.0.0", \
    "--server.port=8080", \
    "--server.headless=true"]